# GitHub Personal Access Token used to check reachability of PRIVATE repos
# and (later) for the worker to clone them. Fine-grained, read access to the
# repos you manage. See delivery/stack.md (HTTPS/secure context) and
# delivery/requirements/ready/req-001-repo-verwaltung.md (Constraints).
GITHUB_TOKEN=

# PostgreSQL connection string (optional). When unset, the app falls back to
# a local JSON file store under .data/ so it runs with zero infra in dev.
# Example: postgres://user:pass@localhost:5432/appbaua
DATABASE_URL=

# Zustandsübersicht der überwachten Apps (req-032). Im Deploy zeigt das auf den
# health-agent — den einzigen Dienst mit Zugriff auf die Docker-Engine (siehe
# docker-compose.yml). Bleibt es leer, spricht die App selbst mit dem
# Docker-Socket; das ist der Fall lokaler Entwicklung auf dem eigenen Rechner.
# Ohne beides melden die Container-Prüfungen "Docker nicht erreichbar" — die
# App läuft trotzdem.
HEALTH_AGENT_URL=

# Nur für den lokalen Fall: wo der Docker-Socket liegt (Vorgabe
# /var/run/docker.sock).
DOCKER_SOCKET=

# Telegram-Meldungen und -Befehle (req-033). Beides optional: fehlt eines von
# beidem, meldet appbaua keine Ausfälle und nimmt keine Befehle entgegen — die
# Überwachung selbst läuft unverändert weiter.
#
# TELEGRAM_BOT_TOKEN  der Schlüssel des Bots, wie ihn @BotFather ausgibt.
# TELEGRAM_CHAT_ID    die EINE zugelassene Chat-Kennung. Ein Bot ist öffentlich
#                     ansprechbar; der ganze Schutz liegt darin, dass nur
#                     Nachrichten aus diesem Chat beantwortet werden. Die eigene
#                     Kennung nennt der Bot, wenn man ihm schreibt und danach
#                     https://api.telegram.org/bot<TOKEN>/getUpdates aufruft.
#
# dev und prod sollten je einen EIGENEN Bot bekommen, sonst kämen beide
# Umgebungen im selben Chat an und man wüsste nicht, welche gerade meldet.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Herzschlag zum Ausfallwächter beim Webhoster (req-034). Fällt DIESER Rechner
# aus, ist die Überwachung oben mit weg — der Wächter steht deshalb woanders und
# meldet, wenn der Herzschlag ausbleibt. Ohne die beiden Werte schlägt appbaua
# keinen Herzschlag und läuft ansonsten unverändert weiter.
#
# WATCHDOG_URL    volle Adresse der heartbeat.php beim Hoster.
# WATCHDOG_TOKEN  die gemeinsame Kennung, Zeichen für Zeichen dieselbe wie in
#                 der config.php beim Hoster. Ohne sie wird der Aufruf
#                 abgewiesen und NICHT als Herzschlag gewertet.
#
# Einrichtung des Wächters: watchdog/README.md. Je Umgebung ein eigener
# Wächter — sonst hielte ein laufendes dev den prod-Rechner für lebendig.
WATCHDOG_URL=
WATCHDOG_TOKEN=

# Abstand der Herzschläge in Minuten. Optional, Vorgabe 5; erlaubt sind 1–10,
# denn der Wächter meldet nach 15 Minuten ohne Herzschlag.
WATCHDOG_INTERVAL_MINUTES=
