# Worker process (req-004): runs the simulated execution loop via tsx.
# Needs the TS source + node_modules at runtime, so no standalone build.

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Install ALL deps (tsx is a runtime dep; the loop imports lib/*.ts directly).
COPY package.json package-lock.json ./
RUN npm ci

# Only the code the worker needs.
COPY tsconfig.json ./
COPY lib ./lib
COPY worker ./worker

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 worker
USER worker

CMD ["npm", "run", "worker"]
