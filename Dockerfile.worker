# Worker process (req-004/006): runs the execution loop via tsx and invokes
# Claude Code headless to do real work in cloned target repos.

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Where the worker clones target repos (must be writable by the worker user).
ENV WORKER_WORKDIR=/work

# git for cloning/committing/pushing; the Claude Code CLI for real execution.
#
# bash: Claude Code runs every shell command of its Bash tool through bash, and
# Alpine ships only busybox sh (bug-016). Without it EVERY command the worker
# tries fails — it can write code but never run `npm test`, `tsc` or `lint` to
# check it, so every run ends with "could not verify locally". Cheap package,
# and the whole test-gate idea (req-019) depends on it.
#
# chromium: the Doku task photographs the app's running dev environment for the
# user documentation (req-017). Playwright ships no browser for musl/Alpine, so
# the browser comes from the distribution and playwright-core is pointed at it
# via CHROMIUM_PATH; the font packages are what keeps the screenshots from
# rendering as empty boxes.
#
# The rest is what the supervised repos need to be worked on at all (bug-024).
# Without them Claude spent the first half of a run building a runtime under
# /tmp — which the next run no longer finds:
#
# perl, exiftool: Knipsa reads capture time, GPS and keywords out of photos.
# python3, py3-pip: Wellarita is not a Node project, its backend is Python and
#   its stack.md calls `pip install -e` and `pytest`. PEP 668 marks Alpine's
#   python3 as externally managed and the worker is not root, so the way in is
#   a per-repo venv (`python3 -m venv .venv`) — py3-pip is what lets `venv`
#   bootstrap itself.
# make, gcc, g++, musl-dev, python3-dev: Alpine is musl, not glibc. Native node
#   modules and pip packages that ship prebuilt binaries rarely have a musl
#   build and get compiled instead — node-gyp and pip need exactly this chain,
#   which is why these five belong together.
#
# Deliberately NOT here: ffmpeg, imagemagick, sqlite3, jq. Measured as missing,
# but no repo asks for them, and every package costs image size and build time.
# They go in when one actually does — req-039 is the lasting answer, where a
# repo declares its own system dependencies.
RUN apk add --no-cache bash git openssh chromium nss freetype harfbuzz ttf-freefont \
  perl exiftool python3 py3-pip make gcc g++ musl-dev python3-dev \
  && npm install -g @anthropic-ai/claude-code
ENV CHROMIUM_PATH=/usr/bin/chromium-browser
# Some tools read SHELL to decide what to spawn; Alpine leaves it unset.
ENV SHELL=/bin/bash

# Install ALL deps (tsx is a runtime dep; the loop imports lib/*.ts directly).
COPY package.json package-lock.json ./
RUN npm ci

# Only the code the worker needs.
COPY tsconfig.json ./
COPY lib ./lib
COPY worker ./worker

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 worker \
  && mkdir -p /work /claude-home \
  && chown -R worker:nodejs /work /claude-home
# Claude Code auth lives here (mounted volume); no API key.
ENV HOME=/claude-home
USER worker

CMD ["npm", "run", "worker"]
