# Worker process (req-004/006): runs the execution loop via tsx and invokes
# Claude Code headless to do real work in cloned target repos.

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Where the worker clones target repos (must be writable by the worker user).
ENV WORKER_WORKDIR=/work

# git for cloning/committing/pushing; the Claude Code CLI for real execution.
RUN apk add --no-cache git openssh \
  && npm install -g @anthropic-ai/claude-code

# Install ALL deps (tsx is a runtime dep; the loop imports lib/*.ts directly).
COPY package.json package-lock.json ./
RUN npm ci

# Only the code the worker needs.
COPY tsconfig.json ./
COPY lib ./lib
COPY worker ./worker

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 worker \
  && mkdir -p /work && chown -R worker:nodejs /work
USER worker

CMD ["npm", "run", "worker"]
